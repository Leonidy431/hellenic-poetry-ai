Расчётная формула:
CEFR_Level = 0.3 × LexicalScore + 0.4 × GrammarScore + 0.2 × SyntaxScore + 0.1 ×
ComplexityScore
from collections import Counter
import nlp_library # SpaCy для греческого, или GyGre
class CEFRDetector:
def init(self, greek_corpus_frequency_dict):
self.freq_dict = greek_corpus_frequency_dict # Частоты слов
self.cefr_vocabulary = {
'A1': set([...]), # Базовые 500 слов
'A2': set([...]), # 1000-1500 слов
# ... до C2
}
def analyze_text(self, text):
tokens = self.tokenize_greek(text)
# Лексический анализ
lexical_score = self._calculate_lexical_score(tokens)
# Грамматический анализ
grammar_score = self._analyze_grammar(tokens)
# Синтаксический анализ
syntax_score = self._analyze_syntax(text)
# Сложность
complexity_score = self._calculate_complexity(text)
Реализация (Python)
# Общий уровень
cefr_level = self._determine_cefr_level(
lexical_score, grammar_score, syntax_score, complexity_score
)
return {
'level': cefr_level,
'confidence': 0.85,
'lexical_score': lexical_score,
'grammar_score': grammar_score,
'syntax_score': syntax_score,
}
def _calculate_lexical_score(self, tokens):
# Процент слов из каждого уровня CEFR
scores = {}
for level in ['A1', 'A2', 'B1', 'B2', 'C1', 'C2']:
match_count = sum(1 for t in tokens if t in self.cefr_vocabulary[level])
scores[level] = match_count / len(tokens) if tokens else 0
return scores
def _analyze_grammar(self, tokens):
# POS-tagging, анализ морфологических категорий
pos_tags = self.pos_tagger.tag(tokens)
# Подсчёт глагольных форм, падежей, времён
tense_complexity = self._count_tense_forms(pos_tags)
case_diversity = self._count_case_diversity(pos_tags)
return (tense_complexity + case_diversity) / 2
def _analyze_syntax(self, text):
# Глубинный парсинг (зависимостный или фразовый)
parse_tree = self.dependency_parser.parse(text)
depth = self._calculate_tree_depth(parse_tree)
subordination = self._count_subordination(parse_tree)
return (depth + subordination) / 2
def _determine_cefr_level(self, lex, gram, syn, comp):
score = 0.3 * lex['B1'] + 0.4 * gram + 0.2 * syn + 0.1 * comp
# Логика маппирования на CEFR
if score < 0.3:
return 'A1'
elif score < 0.5:
return 'A2'
# ... и т.д.
return 'C2'
