class ErrorExplainer:
def explain(self, error, context_text):
explanations = {
'agreement': self._explain_agreement,
'verb_form': self._explain_verb,
'preposition_article': self._explain_prep_art,
'word_order': self._explain_word_order,
'tense_mismatch': self._explain_tense,
}
explain_func = explanations.get(error['type'])
return explain_func(error, context_text)
def _explain_agreement(self, error, context):
return {
'rule': 'Согласование рода-числа-падежа',
'brief': f"Слово '{error['token']}' не согласуется с соседним словом в роде
'example': self._find_similar_correct_example(error),
'mnemonic': 'Подумайте о чёрных кошках (το μαύρο γατάκι) - все слова
}
def _explain_verb(self, error, context):
return {
'rule': 'Спряжение глагола',
'brief': f"Глагол '{error['token']}' спряжен неправильно для данного вре
'correct_form': error['suggestion'],
'pattern': self._extract_verb_pattern(error),
'mnemonic': 'Активные глаголы (1 класс) - ω, εις, ει; 2 класс - ώ, ας, ά'
}
