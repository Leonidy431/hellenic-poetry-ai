# АЛГОРИТМ СОКРАТИЧЕСКОГО АНАЛИЗА
# ============================================================================

```python
class SocratAnalyzer:
    """
    Анализатор пси-состояния на основе сократического метода
    """

    def analyze_session(self, psi_state: dict) -> dict:
        """
        Полный анализ сессии обучения
        """
        analysis = {
            "emotional_insight": self._analyze_emotions(psi_state),
            "cognitive_insight": self._analyze_cognition(psi_state),
            "learning_path": self._recommend_path(psi_state),
            "socratic_questions": self._generate_questions(psi_state)
        }
        return analysis

    def _analyze_emotions(self, state: dict) -> dict:
        """
        Эмоциональный анализ в духе Сократа
        """
        emotions = state["emotional_state"]

        # Определяем эмоциональный баланс
        positive = emotions["engagement"] + emotions["confidence"] + emotions["curiosity"]
        negative = emotions["frustration"] + emotions["fatigue"]

        balance = positive / (positive + negative + 0.001)

        insight = {
            "balance": balance,
            "dominant_emotion": self._find_dominant(emotions),
            "interpretation": self._interpret_emotions(emotions, balance)
        }

        return insight

    def _analyze_cognition(self, state: dict) -> dict:
        """
        Когнитивный анализ
        """
        cognitive = state["cognitive_state"]

        # Отношение самокоррекции к ошибкам
        error_analysis = cognitive["error_analysis"]
        self_correction_ratio = (
            error_analysis["self_corrections"] /
            (error_analysis["total_errors"] + 0.001)
        )

        insight = {
            "self_correction_ratio": self_correction_ratio,
            "learning_efficiency": self._calculate_efficiency(cognitive),
            "creative_potential": cognitive["creative_output"]["value"],
            "pattern_strength": cognitive["pattern_recognition"]["value"]
        }

        return insight

    def _recommend_path(self, state: dict) -> dict:
        """
        Рекомендации для следующей сессии
        """
        # Анализируем слабые места
        weak_topics = self._find_weak_topics(state["progress_tracking"])

        # Определяем оптимальный подход
        learning_style = state["cognitive_state"]["learning_style"]["primary"]
        approach = self._style_to_approach(learning_style)

        # Определяем оптимальную длительность
        fatigue = state["emotional_state"]["fatigue"]["value"]
        duration = self._calculate_optimal_duration(fatigue)

        return {
            "focus_topics": weak_topics[:3],  # Топ-3 слабых темы
            "approach": approach,
            "duration": duration,
            "mood": self._recommend_mood(state)
        }

    def _generate_questions(self, state: dict) -> list:
        """
        Генерация сократических вопросов для следующей сессии
        """
        questions = []

        # На основе ошибок
        for error in state["cognitive_state"]["error_analysis"]["persistent_errors"]:
            questions.append(
                f"Почему ты думаешь, что {error} — это правильно?"
            )

        # На основе интересов
        for topic in state["emotional_state"]["curiosity"]["topics_of_interest"]:
            questions.append(
                f"Что бы ты хотел узнать больше о {topic}?"
            )

        # На основе прогресса
        if state["emotional_state"]["confidence"]["growth_pattern"] == "increasing":
            questions.append(
                "Ты чувствуешь, что становишься увереннее. Почему?"
            )

        return questions
```

