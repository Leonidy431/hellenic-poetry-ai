      protocol: "websocket"

    - name: "perplexity_research"
      port: 8082
      protocol: "http"

    - name: "poetry_engine"
      port: 8083
      protocol: "grpc"

    - name: "socrat_bot_connector"
      port: 8084
      protocol: "http"

  database:
    type: "postgresql"
    name: "language_learning_db"
    tables:
      - user_progress
      - grammar_topics_99
      - poems_created
      - psi_states
      - dialog_history

  ai_models:
    primary: "claude-opus-4-5"
    research: "perplexity-sonar-large"
    poetry: "custom-poetry-fine-tuned"

  features:
    - interactive_dialogs
    - poetry_creation
    - grammar_99_topics
    - psi_state_tracking
    - socrat_integration
    - perplexity_research
    - spaced_repetition
    - voice_support
```

# ============================================================================
# API ENDPOINTS
# ============================================================================

```
POST /api/v1/session/start
  - Начало новой сессии обучения

POST /api/v1/dialog/message
  - Отправка сообщения в диалоге

GET /api/v1/grammar/{topic_id}
  - Получение темы грамматики (1-99)

POST /api/v1/poetry/create
  - Создание стиха с проверкой грамматики

POST /api/v1/poetry/continue
  - Продолжение совместной поэмы

GET /api/v1/progress/{user_id}
  - Прогресс пользователя

POST /api/v1/perplexity/research
  - Исследование через Perplexity

POST /api/v1/session/end
  - Завершение сессии с передачей в Сократ бот

GET /api/v1/psi-state/{session_id}
  - Получение пси-состояния сессии
```

